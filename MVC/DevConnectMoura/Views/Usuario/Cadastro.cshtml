   @model DevConnectMoura.Models.TbUsuario  
  
   <link rel="shortcut icon" href="~/images/logodevconnect.png" type="image/x-icon">
   <link rel="stylesheet" href="~/css/cadastro.css">
    <script defer>
      let Usuarionovocadastrado = "@ViewBag.UsuarioNovoCadastrado";
      if(Usuarionovocadastrado == "Erro ao cadastrar usuario!")
      {
        alert("Não foi possível cadastrar o usuário, tente novamente.");
      }
    </script>

<body>
    <h1>Tela Principal Cadastro - DevConnect</h1>
      <main>
          <div>
           
              <form class="estilo-formulario" asp-action="Cadastro" asp-controller="Usuario" enctype="multipart/form-data">
                  <img src="~/images/Propriedade 1=Padrão.svg" alt="Logo DevConnect">

                  <p>Cadastre-se para a comunidades exclusiva de desenvolvedores(as)</p>

                  <div class="formulario-campo">
                      <label for="">Email:</label>
                      <input type="email" asp-for="Email" id="">
                  </div>
                
                  <div class="formulario-campo">
                      <label for="">Nome e Sobrenome:</label>
                      <input type="text" asp-for="NomeCompleto" id="">
                  </div>

                  <div class="formulario-campo">
                      <label for="">Nome de usuário:</label>
                      <input type="text" asp-for="NomeUsuario" id="">
                  </div>


                  <div class="formulario-campo">
                      <label for="">Senha:</label>
                      <input type="password" asp-for="Senha" id="">
                  </div>

                  <div class="upload">
                   <label for="upload">FAÇA O UPLOAD DA SUA FOTO DE PERFIL AQUI</label>
                   <input type="file" name="upload" id="upload">
                  </div>

                  <button type="submit" class="formulario-botao-verde">Entrar</button>

                  <p>Ao se cadastrar, você concorda com nossos Termos, Política de Dados e Politica de Cookies</p>

              </form>

              <section id="secao-cadastro" class="estilo-formulario">
                <p>Já tem uma conta? <a asp-controller="Home" asp-action="Index">Entrar</a></p>
              </section>

              <p>Obtenha o aplicativo</p>

              <section id="secao-instalacao">
                  <img src="~/images/app-store.svg" alt="Imagem falando da instalação no App Store">

                  <img src="~/images/google-play.svg" alt="Imagem falando da instalação no Play Store">
              </section>

          </div>
      </main>
</body>
