@model DevConnectMoura.Models.TbUsuario

@{
    ViewData["Title"] = "Logo DevConnect";
}

   <link rel="shortcut icon" href="~/images/logodevconnect.png" type="image/x-icon">
   <link rel="stylesheet" href="~/css/login.css">

    <script defer>
      let Usuarionovocadastrado = "@TempData["UsuarioNovoCadastrado"]";
      if(Usuarionovocadastrado == "Usuario cadastrado com sucesso!")
      {
        alert("Usuario cadastrado com sucesso, se logue para navegar na nossa plataforma!");
      }
    </script>

   <h1>Tela principal login - DevConnect</h1>
    <main>
        <div>
            <!-- formulario -->
            <form class="estilo-formulario">
                <img src="~/images/Propriedade 1=Padrão.svg" alt="Logo DevConnect">

                <div class="formulario-campos">
                    <label for="">Nome de usuário:</label>
                    <input type="text" name="" id="">
                </div>

                <div class="formulario-campos">
                    <label for="">Senha:</label>
                    <input type="password" name="" id="">
                </div>

                <button type="submit" class="formulario-botao-verde">Entrar</button>

                <p>ou</p>

                <a href="#">Esqueceu a senha?</a>

            </form>

            <section id="secao-cadastro" class="estilo-formulario">
                <p>Não tem uma conta? <a asp-controller="Usuario" asp-action="Cadastro">Cadastre-se</a></p>
            </section>

            <p>Obtenha o aplicativo</p>

            <section id="secao-instalacao">
                <img src="~/images/app-store.svg" alt="Imagem falando da instalação no App Store">

                <img src="~/images/google-play.svg" alt="Imagem falando da instalação no Play Store">
            </section>
        </div>
    </main>